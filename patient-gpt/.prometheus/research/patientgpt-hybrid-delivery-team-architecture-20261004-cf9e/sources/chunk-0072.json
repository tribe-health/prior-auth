  "text": "LOCAL SOURCE EXCERPT, read from filesystem; line numbers preserved.\n17: const appWindow: TauriWindow | null = isTauri() ? getCurrentWindow() : null\n18: \n19: function WindowControlsMac() {\n20:   return (\n21:     <div className=\"flex items-center gap-2 pl-2\">\n22:       <button\n23:         aria-label=\"Close\"\n24:         onClick={() => appWindow?.close()}\n25:         className=\"h-3 w-3 rounded-full bg-[#FF5F57] hover:brightness-90 active:brightness-75\"\n26:       />\n27:       <button\n28:         aria-label=\"Minimize\"\n29:         onClick={() => appWindow?.minimize()}\n30:         className=\"h-3 w-3 rounded-full bg-[#FEBC2E] hover:brightness-90 active:brightness-75\"\n31:       />\n32:       <button\n33:         aria-label=\"Maximize\"\n34:         onClick={() => appWindow?.toggleMaximize()}\n35:         className=\"h-3 w-3 rounded-full bg-[#28C840] hover:brightness-90 active:brightness-75\"\n36:       />\n37:     </div>\n38:   )\n39: }\n40: \n41: function WindowControlsWindows() {\n42:   return (\n43:     <div className=\"flex items-stretch\">\n44:       <button\n45:         aria-label=\"Minimize\"\n46:         onClick={() => appWindow?.minimize()}\n47:         className=\"flex h-8 w-11 items-center justify-center text-[color:var(--color-fg-sub)] hover:bg-[color:var(--color-card-hov)]\"\n48:       >\n49:         &#xE921;\n50:       </button>\n51:       <button\n52:         aria-label=\"Maximize\"\n53:         onClick={() => appWindow?.toggleMaximize()}\n54:         className=\"flex h-8 w-11 items-center justify-center text-[color:var(--color-fg-sub)] hover:bg-[color:var(--color-card-hov)]\"\n55:       >\n56:         &#xE922;\n57:       </button>\n58:       <button\n59:         aria-label=\"Close\"\n60:         onClick={() => appWindow?.close()}\n61:         className=\"flex h-8 w-11 items-center justify-center text-[color:var(--color-fg-sub)] hover:bg-[#E81123] hover:text-white\"\n62:       >\n63:         &#xE8BB;\n64:       </button>\n65:     </div>\n66:   )\n67: }\n68: \n69: export function Titlebar() {\n70:   const { openSettings } = useSettingsOverlay()\n71:   const [os] = useState(() => {\n72:     if (!isTauri()) return null\n73:     try {\n74:       return platform()\n75:     } catch {\n76:       return null\n77:     }\n78:   })\n79: \n80:   const isMac = os === 'macos'\n81: \n82:   // data-tauri-drag-region marks the drag surface, but Tauri's own webview-side\n83:   // listener only fires reliably on a direct mousedown against that element \u2014\n84:   // explicitly calling startDragging() here makes the whole bar (including the\n85:   // flex spacers around the lockup) draggable rather than only whichever DOM\n86:   // node the attribute landed on.\n87:   const startDrag = (e: React.MouseEvent) => {\n88:     if (e.button !== 0) return\n89:     void appWindow?.startDragging()\n90:   }\n91: \n92:   return (\n93:     <header\n94:       data-tauri-drag-region\n95:       onMouseDown={startDrag}\n96:       className=\"flex h-9 shrink-0 items-center bg-[color:var(--color-bg-2)] select-none\"\n97:     >\n98:       {isMac && <WindowControlsMac />}\n99:       <div className=\"flex flex-1 items-center justify-center gap-2 text-[color:var(--color-fg)]\">\n100:         <KnowMeLogo size={16} className=\"text-[color:var(--color-fg)]\" />\n101:         <KnowMeWordmark className=\"text-[13px]\" />\n102:       </div>\n103:       <button\n104:         type=\"button\"\n105:         aria-label=\"Open settings\"\n106:         title=\"Settings\"\n107:         onMouseDown={(event) => event.stopPropagation()}\n108:         onClick={openSettings}\n109:         className=\"flex size-9 items-center justify-center rounded-lg text-[color:var(--color-fg-sub)] hover:bg-[color:var(--color-card-hov)] hover:text-[color:var(--color-fg)] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[color:var(--color-ember)]\"\n110:       >\n111:         <Settings aria-hidden className=\"size-4\" />\n112:       </button>\n113:       {isTauri() && os !== null && !isMac && <WindowControlsWindows />}\n114:     </header>\n115:   )",
