{{- /*
  riverpod_notifier.dart.tera — Riverpod 3.x AsyncNotifier wrapping a Rust FFI call
  Variables:
    feature_name   : snake_case feature name (e.g. "inference")
    FeatureName    : PascalCase feature name (e.g. "Inference")
    ResultType     : Dart return type from Rust FFI (e.g. "String")
    rust_fn_name   : Generated Rust bridge function name (e.g. "runInference")
    rust_fn_args   : Dart named argument list for the Rust call (e.g. "prompt: prompt, model: model")
    InputType      : Dart input type for the perform action (e.g. "InferenceRequest")
*/ -}}
import 'package:riverpod_annotation/riverpod_annotation.dart';
import '../../bridge/gen_ui_core.dart'; // generated by flutter_rust_bridge

part '{{ feature_name }}_notifier.g.dart';

// ─── State ───────────────────────────────────────────────────────────────────

/// State for the {{ FeatureName }} feature.
/// Keep state minimal — no server data cached here; use entity providers for that.
class {{ FeatureName }}State {
  const {{ FeatureName }}State({
    this.result,
    this.isLoading = false,
    this.error,
  });

  final {{ ResultType }}? result;
  final bool isLoading;
  final String? error;

  {{ FeatureName }}State copyWith({
    {{ ResultType }}? result,
    bool? isLoading,
    String? error,
  }) =>
      {{ FeatureName }}State(
        result: result ?? this.result,
        isLoading: isLoading ?? this.isLoading,
        error: error,
      );
}

// ─── Notifier ────────────────────────────────────────────────────────────────

@riverpod
class {{ FeatureName }}Notifier extends _${{ FeatureName }}Notifier {
  @override
  {{ FeatureName }}State build() => const {{ FeatureName }}State();

  /// Execute the Rust FFI call.
  /// The component never calls Rust directly — always through this notifier.
  Future<void> perform({{ InputType }} input) async {
    state = state.copyWith(isLoading: true, error: null);
    try {
      final result = await {{ rust_fn_name }}({{ rust_fn_args }});
      state = state.copyWith(result: result, isLoading: false);
    } catch (e, stack) {
      state = state.copyWith(
        isLoading: false,
        error: e.toString(),
      );
      // Log but don't rethrow — UI reads state.error
      debugPrint('{{ FeatureName }}Notifier.perform failed: $e\n$stack');
    }
  }

  void reset() => state = const {{ FeatureName }}State();
}

// ─── Convenience providers ────────────────────────────────────────────────────

/// Watch just the result — rebuilds only when result changes.
@riverpod
{{ ResultType }}? {{ feature_name }}Result({{ FeatureName }}ResultRef ref) =>
    ref.watch({{ feature_name }}NotifierProvider).result;

/// Watch loading state separately.
@riverpod
bool {{ feature_name }}IsLoading({{ FeatureName }}IsLoadingRef ref) =>
    ref.watch({{ feature_name }}NotifierProvider).isLoading;
