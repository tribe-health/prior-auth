{
  "schemaVersion": 1,
  "scope": "RA08 synthetic identity/normalization acceptance only; production SQL materializer remains RA11c",
  "sources": [
    "crates/aso-host/src/projection.rs",
    "web/src/shared/sync/electric-shapes.ts",
    "web/src/shared/sync/pglite-schema.ts",
    "docs/design/schema/schema.sql"
  ],
  "tables": [
    {
      "table": "cases",
      "entityType": "Case",
      "primaryKey": "id",
      "columns": {
        "id": "UUID",
        "practice_id": "UUID",
        "status": "TEXT",
        "gate_affirmed_at": "TIMESTAMPTZ",
        "created_at": "TIMESTAMPTZ",
        "updated_at": "TIMESTAMPTZ"
      }
    },
    {
      "table": "case_evidence",
      "entityType": "CaseEvidence",
      "primaryKey": "id",
      "columns": {
        "id": "UUID",
        "practice_id": "UUID",
        "case_id": "UUID",
        "criterion_id": "UUID",
        "state": "TEXT",
        "assessed_at": "TIMESTAMPTZ",
        "created_at": "TIMESTAMPTZ",
        "updated_at": "TIMESTAMPTZ"
      }
    },
    {
      "table": "evidence_states",
      "entityType": "EvidenceState",
      "primaryKey": "key",
      "columns": {
        "key": "TEXT",
        "label": "TEXT",
        "meaning": "TEXT"
      }
    },
    {
      "table": "evidence_citations",
      "entityType": "EvidenceCitation",
      "primaryKey": "id",
      "columns": {
        "id": "UUID",
        "practice_id": "UUID",
        "case_evidence_id": "UUID",
        "document_id": "UUID",
        "page_number": "INTEGER",
        "relevance": "TEXT",
        "created_at": "TIMESTAMPTZ"
      }
    },
    {
      "table": "documents",
      "entityType": "Document",
      "primaryKey": "id",
      "columns": {
        "id": "UUID",
        "practice_id": "UUID",
        "document_type_id": "UUID",
        "case_id": "UUID",
        "name": "TEXT",
        "effective_date": "DATE",
        "page_count": "INTEGER",
        "content_sha256": "BYTEA"
      }
    }
  ],
  "referenceRows": [
    {
      "key": "met",
      "label": "Met",
      "meaning": "A dated source document satisfies the criterion."
    },
    {
      "key": "gap",
      "label": "Not met",
      "meaning": "A source document exists and it contradicts or falls short of the criterion."
    },
    {
      "key": "void",
      "label": "Not documented",
      "meaning": "No source document addresses the criterion at all. Nothing has been disproved; something must be obtained."
    }
  ],
  "normalization": {
    "fieldNames": "approved SQL snake_case column names; no additional fields",
    "uuid": "string",
    "date": "YYYY-MM-DD string",
    "timestamptz": "UTC ISO8601 string",
    "bytea": "lowercase hexadecimal string",
    "null": "preserved null",
    "unknownEvidenceState": "reject compatibility error; never convert to void"
  }
}
