{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prior Authorization Workbench",
  "version": "0.1.0",
  "identifier": "com.tribehealth.prior-auth",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../web dev",
    "beforeBuildCommand": "pnpm --dir ../../web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prior Authorization Workbench"
      }
    ],
    "security": {
      "capabilities": ["main-clinical-commands"]
    }
  },
  "bundle": {
    "active": false
  }
}
